{
  "name": "cfb-pickem-leagues",
  "main": "packages/backend/src/worker.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],

  "assets": {
    "directory": "packages/frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/*", "!/assets/*"]
  },

  "triggers": {
    "crons": ["*/15 * * * *"]
  },

  // Used by cronTick.ts to short-circuit the scheduled handler when there's no active
  // week, so the 15-min cron doesn't keep waking the Neon compute 24/7 in the off-season.
  // Not bound in env.dev — dev's cron is disabled anyway (see below).
  "kv_namespaces": [
    {
      "binding": "CRON_CACHE",
      "id": "01fc5e4643544c02b9bb918cfb113f05"
    }
  ],

  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 100,
        "period": 60
      }
    }
  ],

  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  
  "vars": {
    // All other env vars are secrets — set via: wrangler secret put <KEY>
    // Required secrets: PROD_DB, JWT_SECRET, CFBD_API_KEY
    // Optional secrets: RESEND_API_KEY, NOTIFICATION_FROM_EMAIL, CLIENT_URL
    // (ntfy/Telegram/Discord are configured per league in the DB, not as secrets)
    "NODE_ENV": "production"
  },

  // Dev environment — deploy with: wrangler deploy --env dev
  // Worker name becomes "cfb-pickem-leagues-dev" (Cloudflare appends the env name),
  // giving a stable URL at cfb-pickem-leagues-dev.<subdomain>.workers.dev
  //
  // `vars` and secrets are NOT inherited from the top-level config and must be set here.
  // Required secrets (see: wrangler secret put <KEY> --env dev):
  //   DEV_DB          — Neon dev branch/database connection string
  //   JWT_SECRET       — use a different value than prod so dev tokens can't be replayed against prod
  //   CFBD_API_KEY     — can reuse the prod key
  // Rate limiter bindings are intentionally omitted here — the app falls back to an
  // in-memory limiter when the binding is absent, which is fine for a single dev worker.
  // Cron is disabled here (empty crons array) so scheduled game imports don't run
  // against the dev DB unattended.
  "env": {
    "dev": {
      "vars": {
        "NODE_ENV": "development"
      },
      "triggers": {
        "crons": []
      }
    },

    // Demo environment — deploy with: pnpm --filter cfb-pickem-api deploy:worker:demo
    // A fully isolated public demo: its own Worker (cfb-pickem-leagues-demo), its own Neon
    // `demo` branch, served at https://cfbpickem-demo.labnerd.net/. See context/specs/demo-mode.md.
    //
    // NODE_ENV=development so the pinned clock (DEV_CURRENT_TIME) is honored and the Worker
    // reads DEV_DB — set DEV_DB to the Neon *demo* branch. PROD_DB must NEVER be set here.
    // Required secrets (wrangler secret put <KEY> --env demo):
    //   DEV_DB           — Neon demo branch connection string
    //   JWT_SECRET       — unique to the demo; never reuse the prod or dev value
    //   CFBD_API_KEY     — set to a dummy value (the schema requires one). The demo never calls
    //                      CFBD, so any leaked code path fails instead of spending quota.
    // Do NOT set RESEND_API_KEY / NOTIFICATION_FROM_EMAIL (no email is ever sent).
    //
    // The only scheduled job is the nightly reset (worker.ts runs it instead of the cron tick).
    // Cron is UTC-only; Chicago midnight is 05:00 UTC (CDT) or 06:00 UTC (CST), so both
    // triggers fire and the handler runs the reset only on the one that lands in Chicago hour 0.
    "demo": {
      "vars": {
        "NODE_ENV": "development",
        "DEMO_MODE": "true",
        // Between week 3 (complete) and week 4 (open for picks) of the seeded 2024 season.
        "DEV_CURRENT_TIME": "2024-09-18T15:00:00Z",
        "SKIP_EMAIL_SEND": "true",
        "CLIENT_URL": "https://cfbpickem-demo.labnerd.net"
      },
      // A separate demo bundle (VITE_DEMO_MODE on, clock pinned). The deploy script builds it
      // first, and this keeps the normal dist from ever being served by the demo Worker
      // or the demo bundle by the production Worker.
      "assets": {
        "directory": "packages/frontend/dist-demo",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/*", "!/assets/*"]
      },
      "triggers": {
        "crons": ["0 5 * * *", "0 6 * * *"]
      },
      "routes": [
        { "pattern": "cfbpickem-demo.labnerd.net", "custom_domain": true }
      ],
      "ratelimits": [
        {
          "name": "AUTH_RATE_LIMITER",
          "namespace_id": "2001",
          "simple": { "limit": 5, "period": 60 }
        },
        {
          "name": "API_RATE_LIMITER",
          "namespace_id": "2002",
          "simple": { "limit": 100, "period": 60 }
        }
      ]
    }
  }
}
