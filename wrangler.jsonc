{
  "name": "cfb-pickem-leagues",
  "main": "packages/backend/src/worker.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],

  "assets": {
    "directory": "packages/frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/*", "!/assets/*"]
  },

  "triggers": {
    "crons": ["*/15 * * * *"]
  },

  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 100,
        "period": 60
      }
    }
  ],

  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  
  "vars": {
    // All other env vars are secrets — set via: wrangler secret put <KEY>
    // Required secrets: PROD_DB, JWT_SECRET, CFBD_API_KEY
    // Optional secrets: RESEND_API_KEY, NOTIFICATION_FROM_EMAIL, NTFY_TOPIC_URL,
    //                   TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID, TELEGRAM_INVITE_URL,
    //                   DISCORD_WEBHOOK_URL, DISCORD_INVITE_URL, CLIENT_URL
    "NODE_ENV": "production"
  },

  // Dev environment — deploy with: wrangler deploy --env dev
  // Worker name becomes "cfb-pickem-leagues-dev" (Cloudflare appends the env name),
  // giving a stable URL at cfb-pickem-leagues-dev.<subdomain>.workers.dev
  //
  // `vars` and secrets are NOT inherited from the top-level config and must be set here.
  // Required secrets (see: wrangler secret put <KEY> --env dev):
  //   DEV_DB          — Neon dev branch/database connection string
  //   JWT_SECRET       — use a different value than prod so dev tokens can't be replayed against prod
  //   CFBD_API_KEY     — can reuse the prod key
  // Rate limiter bindings are intentionally omitted here — the app falls back to an
  // in-memory limiter when the binding is absent, which is fine for a single dev worker.
  // Cron is disabled here (empty crons array) so scheduled game imports don't run
  // against the dev DB unattended.
  "env": {
    "dev": {
      "vars": {
        "NODE_ENV": "development"
      },
      "triggers": {
        "crons": []
      }
    }
  }
}
